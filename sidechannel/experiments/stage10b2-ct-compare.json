{
  "schema_version": 1,
  "id": "stage10b2-ct-compare",
  "description": "Constant-time byte-comparison timing regression.",
  "command": [
    "python3",
    "scripts/stage11_legacy_adapter.py",
    "stage10b2-ct-compare"
  ],
  "working_directory": ".",
  "repetitions": 3,
  "timeout_seconds": 900,
  "parser": {
    "type": "regex",
    "pattern": "stage11_metric=(-?[0-9]+(?:\\.[0-9]+)?)",
    "metric": "welch_t",
    "absolute": true,
    "skip_pattern": "^STAGE11_SKIP:"
  },
  "policy": {
    "minimum_successful_repetitions": 3,
    "maximum": 4.5
  },
  "tags": [
    "stage10b",
    "timing",
    "ct-compare"
  ],
  "enabled": true
}
